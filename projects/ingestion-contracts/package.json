{
  "name": "@news-research/ingestion-contracts",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config/v1": {
      "types": "./dist/lib/config/v1/index.d.ts",
      "import": "./dist/lib/config/v1/index.js",
      "default": "./dist/lib/config/v1/index.js"
    },
    "./events/v1": {
      "types": "./dist/lib/events/v1/index.d.ts",
      "import": "./dist/lib/events/v1/index.js",
      "default": "./dist/lib/events/v1/index.js"
    },
    "./archive/v1": {
      "types": "./dist/lib/archive/v1/index.d.ts",
      "import": "./dist/lib/archive/v1/index.js",
      "default": "./dist/lib/archive/v1/index.js"
    },
    "./logging/v1": {
      "types": "./dist/lib/logging/v1/index.d.ts",
      "import": "./dist/lib/logging/v1/index.js",
      "default": "./dist/lib/logging/v1/index.js"
    },
    "./shared/v1": {
      "types": "./dist/lib/shared/v1/index.d.ts",
      "import": "./dist/lib/shared/v1/index.js",
      "default": "./dist/lib/shared/v1/index.js"
    }
  },
  "dependencies": {
    "@news-research/core-contracts": "0.0.1",
    "effect": "^3.21.0",
    "tslib": "^2.3.0"
  },
  "nx": {
    "name": "ingestion-contracts"
  }
}
