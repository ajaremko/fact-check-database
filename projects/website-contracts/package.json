{
  "name": "@news-research/website-contracts",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./form-submissions/v1": {
      "types": "./dist/form-submissions/v1/index.d.ts",
      "import": "./dist/form-submissions/v1/index.js",
      "default": "./dist/form-submissions/v1/index.js"
    },
    "./search/v1": {
      "types": "./dist/search/v1/index.d.ts",
      "import": "./dist/search/v1/index.js",
      "default": "./dist/search/v1/index.js"
    }
  },
  "nx": {
    "name": "website-contracts",
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "projects/website-contracts/dist",
          "main": "projects/website-contracts/src/index.ts",
          "tsConfig": "projects/website-contracts/tsconfig.lib.json",
          "format": [
            "cjs"
          ],
          "declarationRootDir": "projects/website-contracts/src",
          "esbuildOptions": {
            "outExtension": {
              ".js": ".js"
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "effect": "^3.21.0"
  }
}
