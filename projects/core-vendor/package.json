{
  "name": "@news-research/core-vendor",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./algolia/AlgoliaSearchClient": {
      "types": "./dist/algolia/AlgoliaSearchClient.d.ts",
      "import": "./dist/algolia/AlgoliaSearchClient.js",
      "default": "./dist/algolia/AlgoliaSearchClient.js"
    },
    "./bigquery/BigQueryClient": {
      "types": "./dist/bigquery/BigQueryClient.d.ts",
      "import": "./dist/bigquery/BigQueryClient.js",
      "default": "./dist/bigquery/BigQueryClient.js"
    },
    "./cloud-pubsub/PubsubClient": {
      "types": "./dist/cloud-pubsub/PubsubClient.d.ts",
      "import": "./dist/cloud-pubsub/PubsubClient.js",
      "default": "./dist/cloud-pubsub/PubsubClient.js"
    },
    "./cloud-pubsub/PubsubSubscriberClient": {
      "types": "./dist/cloud-pubsub/PubsubSubscriberClient.d.ts",
      "import": "./dist/cloud-pubsub/PubsubSubscriberClient.js",
      "default": "./dist/cloud-pubsub/PubsubSubscriberClient.js"
    },
    "./cloud-pubsub/PubsubSubscription": {
      "types": "./dist/cloud-pubsub/PubsubSubscription.d.ts",
      "import": "./dist/cloud-pubsub/PubsubSubscription.js",
      "default": "./dist/cloud-pubsub/PubsubSubscription.js"
    },
    "./cloud-pubsub/PubsubTopic": {
      "types": "./dist/cloud-pubsub/PubsubTopic.d.ts",
      "import": "./dist/cloud-pubsub/PubsubTopic.js",
      "default": "./dist/cloud-pubsub/PubsubTopic.js"
    },
    "./cloud-run": {
      "types": "./dist/cloud-run/index.d.ts",
      "import": "./dist/cloud-run/index.js",
      "default": "./dist/cloud-run/index.js"
    },
    "./cloud-storage/StorageBucket": {
      "types": "./dist/cloud-storage/StorageBucket.d.ts",
      "import": "./dist/cloud-storage/StorageBucket.js",
      "default": "./dist/cloud-storage/StorageBucket.js"
    },
    "./cloud-storage/StorageClient": {
      "types": "./dist/cloud-storage/StorageClient.d.ts",
      "import": "./dist/cloud-storage/StorageClient.js",
      "default": "./dist/cloud-storage/StorageClient.js"
    },
    "./pino": {
      "types": "./dist/pino/index.d.ts",
      "import": "./dist/pino/index.js",
      "default": "./dist/pino/index.js"
    },
    "./pino-logging-gcp-config": {
      "types": "./dist/pino-logging-gcp-config/index.d.ts",
      "import": "./dist/pino-logging-gcp-config/index.js",
      "default": "./dist/pino-logging-gcp-config/index.js"
    }
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1",
    "@google-cloud/pino-logging-gcp-config": "^1.3.1",
    "@google-cloud/pubsub": "^5.2.2",
    "@google-cloud/storage": "^7.19.0",
    "@effect/platform-node": "^0.106.0",
    "algoliasearch": "^5.53.0",
    "effect": "^3.21.0",
    "pino": "^10.3.1",
    "tslib": "^2.3.0"
  },
  "nx": {
    "name": "core-vendor"
  }
}
