{
  "name": "@fact-check-database/core-io",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.js",
      "default": "./dist/adapters/*.js"
    },
    "./ports/*": {
      "types": "./dist/ports/*.d.ts",
      "import": "./dist/ports/*.js",
      "default": "./dist/ports/*.js"
    }
  },
  "dependencies": {
    "effect": "^3.21.0",
    "http-status-codes": "^2.3.0",
    "tslib": "^2.3.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-node": "^0.106.0",
    "@google-cloud/pubsub": "^5.2.2",
    "@fact-check-database/core-contracts": "0.0.1",
    "@fact-check-database/core-data": "0.0.1",
    "@fact-check-database/core-vendor": "0.0.1"
  },
  "nx": {
    "name": "core-io"
  }
}
