{
  "name": "@news-research/ingestion-messaging",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/CloudPubsubMessageBatch": {
      "types": "./dist/adapters/CloudPubsubMessageBatch.d.ts",
      "import": "./dist/adapters/CloudPubsubMessageBatch.js",
      "default": "./dist/adapters/CloudPubsubMessageBatch.js"
    },
    "./adapters/CloudPubsubMessageQueueFeeder": {
      "types": "./dist/adapters/CloudPubsubMessageQueueFeeder.d.ts",
      "import": "./dist/adapters/CloudPubsubMessageQueueFeeder.js",
      "default": "./dist/adapters/CloudPubsubMessageQueueFeeder.js"
    },
    "./adapters/CloudPubsubPublisher": {
      "types": "./dist/adapters/CloudPubsubPublisher.d.ts",
      "import": "./dist/adapters/CloudPubsubPublisher.js",
      "default": "./dist/adapters/CloudPubsubPublisher.js"
    },
    "./adapters/FileSystemMessageBatch": {
      "types": "./dist/adapters/FileSystemMessageBatch.d.ts",
      "import": "./dist/adapters/FileSystemMessageBatch.js",
      "default": "./dist/adapters/FileSystemMessageBatch.js"
    },
    "./adapters/FileSystemMessageQueueFeeder": {
      "types": "./dist/adapters/FileSystemMessageQueueFeeder.d.ts",
      "import": "./dist/adapters/FileSystemMessageQueueFeeder.js",
      "default": "./dist/adapters/FileSystemMessageQueueFeeder.js"
    },
    "./adapters/FileSystemPublisher": {
      "types": "./dist/adapters/FileSystemPublisher.d.ts",
