      "default": "./dist/adapters/FileSystemPublisher.js"
    },
    "./adapters/HttpServerMessageQueueFeeder": {
      "types": "./dist/adapters/HttpServerMessageQueueFeeder.d.ts",
      "import": "./dist/adapters/HttpServerMessageQueueFeeder.js",
      "default": "./dist/adapters/HttpServerMessageQueueFeeder.js"
    },
    "./adapters/InMemoryMessageQueue": {
      "types": "./dist/adapters/InMemoryMessageQueue.d.ts",
      "import": "./dist/adapters/InMemoryMessageQueue.js",
      "default": "./dist/adapters/InMemoryMessageQueue.js"
    }
  },
  "dependencies": {
    "effect": "^3.21.0",
    "http-status-codes": "^2.3.0",
    "tslib": "^2.3.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-node": "^0.106.0",
    "@google-cloud/pubsub": "^5.2.2",
    "@news-research/core-vendor": "0.0.1",
    "@news-research/core-data": "0.0.1"
