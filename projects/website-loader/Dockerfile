FROM docker.io/node:lts-alpine

ARG SERVICE_NAME
ARG SERVICE_VERSION

ENV HOST=0.0.0.0
ENV PORT=3000
ENV SERVICE_NAME=${SERVICE_NAME}
ENV SERVICE_VERSION=${SERVICE_VERSION}

WORKDIR /app

