{
  "name": "@news-research/core-website",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "core-website",
    "targets": {
      "serve": {
        "executor": "@nx/next:server",
        "options": {
          "buildTarget": "core-website:build",
          "dev": true,
          "port": 4200
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      }
    },
    "release": {
      "docker": {
        "repositoryName": "core-website"
      }
    }
  },
  "dependencies": {
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
