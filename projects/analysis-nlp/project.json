{
  "name": "analysis-nlp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "projects/analysis-nlp/pipeline",
  "targets": {
    "parse": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "NLTK_DISABLE_IMPORT_SECURITY=1 uv run pipeline/parsing/parse_phrases.py",
        "cwd": "{projectRoot}"
      }
    },
    "pipeline": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "scripts/stance_detection.sh",
        "cwd": "{projectRoot}"
      }
    },
    "install-models": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run -m spacy download en_core_web_sm",
        "cwd": "{projectRoot}"
      }
    },
    "extract-BASIL": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/ingestion/extract_articles_BASIL.py",
        "cwd": "{projectRoot}"
      }
    },
    "extract-ccnews": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/ingestion/extract_articles_ccnews.py",
        "cwd": "{projectRoot}"
      }
    },
    "initialize": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/stance_prediction/initialize_pipeline.py",
        "cwd": "{projectRoot}"
      }
    },
    "segment": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "NLTK_DISABLE_IMPORT_SECURITY=1 uv run pipeline/stance_prediction/segment_passages.py",
        "cwd": "{projectRoot}"
      }
    },
    "embeddings": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/stance_prediction/extract_embeddings.py",
        "cwd": "{projectRoot}"
      }
    },
    "cluster": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/stance_prediction/cluster_embeddings.py",
        "cwd": "{projectRoot}"
      }
    },
    "keywords": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "NLTK_DISABLE_IMPORT_SECURITY=1 uv run pipeline/stance_prediction/extract_keywords.py",
        "cwd": "{projectRoot}"
      }
    },
    "pairings": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/stance_prediction/build_keyword_pairings.py",
        "cwd": "{projectRoot}"
      }
    },
    "stance": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/stance_prediction/predict_stance.py",
        "cwd": "{projectRoot}"
      }
    },
    "aggregate": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/stance_prediction/aggregate_stances.py",
        "cwd": "{projectRoot}"
      }
    },
    "visualize": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/stance_prediction/visualize_pipeline.py",
        "cwd": "{projectRoot}"
      }
    },
    "summaries": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/stance_prediction/extract_summaries.py",
        "cwd": "{projectRoot}"
      }
    },
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "build": {
      "executor": "@nxlv/python:build",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true
      },
      "cache": true
    },
    "lint": {
      "executor": "@nxlv/python:ruff-check",
      "outputs": [],
      "options": {
        "lintFilePatterns": ["pipeline", "tests"]
      },
      "cache": true
    },
    "format": {
      "executor": "@nxlv/python:ruff-format",
      "outputs": [],
      "options": {
        "filePatterns": ["pipeline", "tests"]
      },
      "cache": true
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/{projectRoot}/unittests",
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "command": "uv run pytest tests/",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "verbose": false,
        "debug": false
      }
    }
  },
  "tags": [],
  "release": {
    "version": {
      "versionActions": "@nxlv/python/release/version-actions"
    }
  }
}
