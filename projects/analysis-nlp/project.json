{
  "name": "analysis-nlp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "projects/analysis-nlp/pipeline",
  "targets": {
    "preprocess": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/preprocess_BASIL.py",
        "cwd": "{projectRoot}"
      }
    },
    "segment": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "PYTHONSAFEPATH=1 uv run pipeline/segment_passages.py",
        "cwd": "{projectRoot}"
      }
    },
    "embeddings": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/extract_embeddings.py",
        "cwd": "{projectRoot}"
      }
    },
    "cluster": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/cluster_embeddings.py",
        "cwd": "{projectRoot}"
      }
    },
    "keywords": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pipeline/extract_keywords.py",
        "cwd": "{projectRoot}"
      }
    },
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "build": {
      "executor": "@nxlv/python:build",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true
      },
      "cache": true
    },
    "lint": {
      "executor": "@nxlv/python:ruff-check",
      "outputs": [],
      "options": {
        "lintFilePatterns": ["pipeline", "tests"]
      },
      "cache": true
    },
    "format": {
      "executor": "@nxlv/python:ruff-format",
      "outputs": [],
      "options": {
        "filePatterns": ["pipeline", "tests"]
      },
      "cache": true
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/{projectRoot}/unittests",
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "command": "uv run pytest tests/",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "verbose": false,
        "debug": false
      }
    }
  },
  "tags": [],
  "release": {
    "version": {
      "versionActions": "@nxlv/python/release/version-actions"
    }
  }
}
