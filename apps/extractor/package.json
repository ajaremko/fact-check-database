{
  "name": "@news-research/extractor",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/extractor/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/extractor/src/main.ts",
          "tsConfig": "apps/extractor/tsconfig.app.json",
          "assets": [
            "apps/extractor/src/assets"
          ]
        },
        "configurations": {
          "development": {
            "esbuildConfig": "apps/extractor/esbuild.config.js"
          },
          "production": {
            "esbuildConfig": "apps/extractor/esbuild.config.prod.js",
            "bundle": true,
            "thirdParty": true,
            "generatePackageJson": false
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/extractor/dist/package.json",
          "{workspaceRoot}/apps/extractor/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/extractor/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@news-research/extractor:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@news-research/extractor:build:development"
          },
          "production": {
            "buildTarget": "@news-research/extractor:build:production"
          }
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      }
    }
  },
  "dependencies": {}
}
